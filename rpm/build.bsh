#!/usr/bin/env bash

set -eu

mkdir -p $HOME/rpmbuild/SOURCES

if [ -e "/src/rpm/SOURCES/darling.tar.gz" ]; then
  ln -sf /src/rpm/SOURCES/darling.tar.gz $HOME/rpmbuild/SOURCES/
else
  # Preparing tarball
  tar --transform "s|^\./|./osixie/|" -cf $HOME/rpmbuild/SOURCES/darling.tar.gz -C /src --exclude=.git --exclude SOURCES --exclude SRPMS --exclude RPMS --exclude BUILD .
fi

if [ -e "/src/rpm/SOURCES/osixie-macho-deps.tar.gz" ]; then
  ln -sf /src/rpm/SOURCES/osixie-macho-deps.tar.gz $HOME/rpmbuild/SOURCES/
else
  tar --transform "s|^\./|osixie-macho-deps/|" -cf $HOME/rpmbuild/SOURCES/osixie-macho-deps.tar.gz -C /src/tools/rpm .
fi

if (cd /src && git describe --tags HEAD); then
  OSXIE_COMMIT_DATE="$(cd /src; git describe --tags HEAD)"
  export OSXIE_COMMIT_DATE="${OSXIE_COMMIT_DATE//-/}"
else
  # default to the current date
  export OSXIE_COMMIT_DATE="$(printf '%(%Y%m%d)T\n' -1)"
fi

rpmbuild -bb /src/rpm/SPECS/osixie-macho-deps.spec
sudo rpm -U --force $HOME/rpmbuild/RPMS/x86_64/osixie-macho-deps*.rpm

#spectool -g -R /src/rpm/SPECS/darling.spec
rpmbuild -bb /src/rpm/SPECS/darling.spec
rpmbuild -bb /src/rpm/SPECS/osixie-cli-devenv.spec
