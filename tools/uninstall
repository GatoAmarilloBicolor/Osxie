#!/bin/sh
set +e

if [ "$(whoami)" != "root" ]
then
	echo "Uninstall must be run as root, attempting privilege escalation..."
	if command -v pkexec >/dev/null 2>&1; then
		exec pkexec "$0" "$@"
	elif command -v sudo >/dev/null 2>&1; then
		exec sudo su -c "$0" "$@"
	else
		echo "Error: need root. Install polkit (pkexec) or sudo."
		exit 1
	fi
fi

if command -v osxie
then
	$(dirname "$0")/shutdown-user.sh
fi

INSTALL_PREFIX="$(dirname "$(dirname "$(which osxie)")")"
if [ -d "${INSTALL_PREFIX}/libexec" ]
then
	rm -rf "${INSTALL_PREFIX}/libexec/osxie"
	rmdir --ignore-fail-on-non-empty "${INSTALL_PREFIX}/libexec"
fi
rm -f "${INSTALL_PREFIX}/bin/osxie"
rm -f "${INSTALL_PREFIX}/bin/osxieserver"
rm -f "${INSTALL_PREFIX}/bin/osixie-coredump"
find /lib/modules -name osixie-mach.ko -delete
echo "Uninstall complete"
